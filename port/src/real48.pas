{ Bit-exact Borland Pascal 6-byte Real arithmetic and random numbers.

  The arithmetic cores are a mechanical translation of the Borland runtime in
  kaiser.exe (real48core.inc, generated by tools/emu/x86_to_pascal.py), so
  rounding and truncation match the original exactly. Random/RandomReal follow
  System.Random (RandSeed := RandSeed * $08088405 + 1).

  Register convention of the original: first operand and result in DX:BX:AX,
  second operand in DI:SI:CX; a Real48 r[0..5] maps to AX = r0 + r1*256,
  BX = r2 + r3*256, DX = r4 + r5*256 (r0 = exponent, sign in the top bit of r5). }
unit Real48;

{$mode objfpc}{$H+}
{$goto on}
{$R-}{$Q-}

interface

uses
  SysUtils, Math, KaiserTypes;

type
  ERealError = class(Exception)
  public
    Code: Integer;  { Borland runtime error: 200, 205 or 207 }
    constructor CreateCode(ACode: Integer);
  end;

const
  R48Zero: TReal48 = (0, 0, 0, 0, 0, 0);

function R48Add(const A, B: TReal48): TReal48;
function R48Sub(const A, B: TReal48): TReal48;
function R48Mul(const A, B: TReal48): TReal48;
function R48Div(const A, B: TReal48): TReal48;
{ -1, 0 or 1 like the flags after Borland's real compare }
function R48Cmp(const A, B: TReal48): Integer;
function R48FromLong(V: LongInt): TReal48;
function R48Round(const A: TReal48): LongInt;
function R48Trunc(const A: TReal48): LongInt;
function R48Sqrt(const A: TReal48): TReal48;

{ Str(A:Width:Decimals) of Borland (System _StrReal 10c8:188a with
  _RealToStr / _RealToDigits / _RealScale10 / _RealMul10); Decimals < 0:
  exponent format }
function R48Str(const A: TReal48; Width, Decimals: SmallInt): RawByteString;

{ Conversions for display and tests only - not used by game rules }
function R48ToDouble(const A: TReal48): Double;
function DoubleToR48(D: Double): TReal48;

{ Borland's random number generator }
var
  RandSeed: LongWord;

function Random(Range: Word): Word;
function RandomReal: TReal48;

{ Raw access for differential tests: run a core with given registers }
type
  TCoreEntry = (ceSub, ceAdd, ceMul, ceDiv, ceCmp, ceFromLong, ceToLong);
  TRegs = record
    AX, BX, CX, DX, SI, DI, BP: Word;
    CF, ZF, SF: Boolean;
  end;

procedure RunCore(Entry: TCoreEntry; var R: TRegs);

implementation

constructor ERealError.CreateCode(ACode: Integer);
begin
  inherited CreateFmt('Runtime error %d', [ACode]);
  Code := ACode;
end;

procedure RunCore(Entry: TCoreEntry; var R: TRegs);
var
  Stack: array[0..63] of Byte;
  SP: Integer;
  RetStack: array[0..15] of Integer;
  RetTop: Integer;
  T: LongWord;
  U: LongWord;
  N: Integer;

  procedure Push(V: LongWord);
  begin
    Dec(SP, 2);
    Stack[SP] := V and $FF;
    Stack[SP + 1] := (V shr 8) and $FF;
  end;

  function Pop: Word;
  begin
    Result := Stack[SP] or (Word(Stack[SP + 1]) shl 8);
    Inc(SP, 2);
  end;

  function MemB(Addr: Integer): Byte;
  begin
    Result := Stack[Addr];
  end;

  function MemW(Addr: Integer): Word;
  begin
    Result := Stack[Addr] or (Word(Stack[Addr + 1]) shl 8);
  end;

  procedure SetMemB(Addr: Integer; V: LongWord);
  begin
    Stack[Addr] := V and $FF;
  end;

  procedure SetMemW(Addr: Integer; V: LongWord);
  begin
    Stack[Addr] := V and $FF;
    Stack[Addr + 1] := (V shr 8) and $FF;
  end;

  procedure PushRet(Id: Integer);
  begin
    RetStack[RetTop] := Id;
    Inc(RetTop);
  end;

  function PopRet: Integer;
  begin
    if RetTop = 0 then
      Exit(0);
    Dec(RetTop);
    Result := RetStack[RetTop];
  end;

{$I real48core.inc}

procedure ToRegs(const A, B: TReal48; out R: TRegs);
begin
  FillChar(R, SizeOf(R), 0);
  R.AX := A[0] or (Word(A[1]) shl 8);
  R.BX := A[2] or (Word(A[3]) shl 8);
  R.DX := A[4] or (Word(A[5]) shl 8);
  R.CX := B[0] or (Word(B[1]) shl 8);
  R.SI := B[2] or (Word(B[3]) shl 8);
  R.DI := B[4] or (Word(B[5]) shl 8);
end;

function FromRegs(const R: TRegs): TReal48;
begin
  Result[0] := Lo(R.AX); Result[1] := Hi(R.AX);
  Result[2] := Lo(R.BX); Result[3] := Hi(R.BX);
  Result[4] := Lo(R.DX); Result[5] := Hi(R.DX);
end;

function R48Add(const A, B: TReal48): TReal48;
var
  R: TRegs;
begin
  ToRegs(A, B, R);
  RunCore(ceAdd, R);
  if R.CF then
    raise ERealError.CreateCode(205);
  Result := FromRegs(R);
end;

function R48Sqrt(const A: TReal48): TReal48;
var
  R: TRegs;
  G, NewG: TReal48;
  Target: Byte;

  procedure SetCX(const V: TReal48);
  begin
    R.CX := V[0] or (Word(V[1]) shl 8);
    R.SI := V[2] or (Word(V[3]) shl 8);
    R.DI := V[4] or (Word(V[5]) shl 8);
  end;

begin
  { System.Sqrt (10c8:0f5c): Newton steps g := (x / g + g) / 2 from x with
    the exponent halved, until a step changes less than 2^-20 of g. The
    cores are called without overflow checks, as there. }
  if A[0] = 0 then
    Exit(A);
  if (A[5] and $80) <> 0 then
    raise ERealError.CreateCode(207);
  G := A;
  G[0] := Byte(SarShortint(ShortInt(Byte(A[0] + $80)), 1) + $80);
  Target := Byte(G[0] - $14);
  repeat
    ToRegs(A, G, R);
    RunCore(ceDiv, R);
    SetCX(G);
    RunCore(ceAdd, R);
    SetCX(G);
    R.AX := (R.AX and $FF00) or Byte(Lo(R.AX) - 1);          { / 2 }
    NewG := FromRegs(R);
    RunCore(ceSub, R);                                       { NewG - G }
    G := NewG;
  until Lo(R.AX) < Target;
  Result := G;
end;

function R48Sub(const A, B: TReal48): TReal48;
var
  R: TRegs;
begin
  ToRegs(A, B, R);
  RunCore(ceSub, R);
  if R.CF then
    raise ERealError.CreateCode(205);
  Result := FromRegs(R);
end;

function R48Mul(const A, B: TReal48): TReal48;
var
  R: TRegs;
begin
  ToRegs(A, B, R);
  RunCore(ceMul, R);
  if R.CF then
    raise ERealError.CreateCode(205);
  Result := FromRegs(R);
end;

function R48Div(const A, B: TReal48): TReal48;
var
  R: TRegs;
begin
  if B[0] = 0 then
    raise ERealError.CreateCode(200);
  ToRegs(A, B, R);
  RunCore(ceDiv, R);
  if R.CF then
    raise ERealError.CreateCode(205);
  Result := FromRegs(R);
end;

function R48Cmp(const A, B: TReal48): Integer;
var
  R: TRegs;
begin
  ToRegs(A, B, R);
  RunCore(ceCmp, R);
  if R.ZF then
    Result := 0
  else if R.CF then
    Result := -1
  else
    Result := 1;
end;

function R48FromLong(V: LongInt): TReal48;
var
  R: TRegs;
begin
  FillChar(R, SizeOf(R), 0);
  R.AX := LongWord(V) and $FFFF;
  R.DX := LongWord(V) shr 16;
  RunCore(ceFromLong, R);
  Result := FromRegs(R);
end;

function ToLong(const A: TReal48; RoundIt: Boolean): LongInt;
var
  R: TRegs;
begin
  ToRegs(A, R48Zero, R);
  R.CX := Ord(RoundIt) shl 8;
  RunCore(ceToLong, R);
  if R.CF then
    raise ERealError.CreateCode(207);
  Result := LongInt(LongWord(R.AX) or (LongWord(R.DX) shl 16));
end;

function R48Round(const A: TReal48): LongInt;
begin
  Result := ToLong(A, True);
end;

function R48Trunc(const A: TReal48): LongInt;
begin
  Result := ToLong(A, False);
end;

{ -- Str(Real) ------------------------------------------------------------- }

const
  { _RealScale10's table (CS:1784): 1e0, 1e4, 1e8, ... 1e36 }
  Pow10k: array[0..59] of Byte = (
    $81, $00, $00, $00, $00, $00, $8E, $00, $00, $00, $40, $1C, $9B, $00, $00, $20, $BC, $3E,
    $A8, $00, $10, $A5, $D4, $68, $B6, $04, $BF, $C9, $1B, $0E, $C3, $AC, $C5, $EB, $78, $2D,
    $D0, $CD, $CE, $1B, $C2, $53, $DE, $F9, $78, $39, $3F, $01, $EB, $2B, $A8, $AD, $C5, $1D,
    $F8, $C9, $7B, $CE, $97, $40);
  Mask48 = QWord($FFFFFFFFFFFF);

function ToM48(const A: TReal48): QWord;
var
  I: Integer;
begin
  Result := 0;
  for I := 5 downto 0 do
    Result := (Result shl 8) or A[I];
end;

function FromM48(M: QWord): TReal48;
var
  I: Integer;
begin
  for I := 0 to 5 do
  begin
    Result[I] := Byte(M);
    M := M shr 8;
  end;
end;

{ _RealMul10 (10c8:17c0): times 10 as 1.25 * 8, rounded at the byte }
procedure RealMul10(var A: TReal48);
var
  E: Byte;
  M, S: QWord;
begin
  if A[0] = 0 then
    Exit;
  E := A[0];
  M := (ToM48(A) and not QWord($FF)) or (QWord($80) shl 40);
  S := M + (M shr 2);
  if S > Mask48 then
  begin
    S := S shr 1;                       { RCR with the carry }
    if E = $FF then
    begin
      A := FromM48(S and Mask48);
      Exit;
    end;
    Inc(E);
  end;
  S := S + $80;
  if S > Mask48 then
  begin
    S := (S and $FFFFFFFF) or (QWord($8000) shl 32);   { RCR DX only }
    if E = $FF then
    begin
      A := FromM48(S);
      Exit;
    end;
    Inc(E);
  end;
  A := FromM48(S and Mask48);
  A[5] := A[5] and $7F;
  A[0] := Byte(E + 3);
end;

{ _RealScale10 (10c8:1734): A * 10^N for -38 <= N <= 38 }
procedure RealScale10(var A: TReal48; N: ShortInt);
var
  P: TReal48;
  K, I: Integer;
begin
  if (N < -38) or (N > 38) then
    Exit;
  K := Abs(N);
  Move(Pow10k[(K and $FC) div 4 * 6], P, 6);
  for I := 1 to K and 3 do
    RealMul10(P);
  if N < 0 then
    A := R48Div(A, P)
  else
    A := R48Mul(A, P);
end;

{ _RealToDigits (10c8:15bf): 12 decimal digits of |A| and the exponent }
function RealToDigits(A: TReal48; var Digits: array of Char): SmallInt;
var
  T: SmallInt;
  Sh, I: Integer;
  M: QWord;
begin
  if A[0] = 0 then
  begin
    for I := 0 to 11 do
      Digits[I] := '0';
    Digits[12] := #0;
    Exit(0);
  end;
  A[5] := A[5] and $7F;
  T := SmallInt(ShortInt(A[0] - $80)) * $4D + 5;
  Result := ShortInt(Hi(Word(T)));
  if Result = -39 then
    Result := -38;
  RealScale10(A, ShortInt(-Result));
  if A[0] < $81 then
  begin
    RealMul10(A);
    Dec(Result);
  end;
  M := (ToM48(A) or (QWord($80) shl 40)) and not QWord($FF);
  Sh := Byte($84 - A[0]);
  for I := 1 to Sh do
    M := M shr 1;
  for I := 0 to 11 do
  begin
    Digits[I] := Chr(Byte((M shr 44) + $30));
    M := ((M and ((QWord(1) shl 44) - 1)) * 10) and Mask48;
  end;
  Digits[12] := #0;
end;

{ _RealToStr (10c8:14c7) }
function RealToStr(const A: TReal48; Decimals: SmallInt): RawByteString;
var
  Digits: array[0..12] of Char;
  E, SI, CX, D: SmallInt;
  Neg: Boolean;

  function NextDigit: Char;
  begin
    Result := Digits[SI];
    Inc(SI);
    if Result = #0 then
    begin
      Result := '0';
      Dec(SI);
    end;
  end;

begin
  if Decimals > 11 then Decimals := 11;
  if Decimals < -11 then Decimals := -11;
  D := Decimals;
  Neg := A[5] and $80 <> 0;
  E := RealToDigits(A, Digits);
  Result := '';
  SI := D;
  if SI >= 0 then
    SI := SI + E + 1
  else
    SI := -SI;
  if (D >= 0) and (SI < 0) then
    Digits[0] := #0
  else
  begin
    if Word(SI) >= 12 then
      SI := 11;
    if Digits[SI] < '5' then
      Digits[SI] := #0
    else
    begin
      Digits[SI] := #0;
      repeat
        Dec(SI);
        if SI < 0 then
        begin
          Digits[0] := '1';
          Digits[1] := #0;
          Inc(E);
          Break;
        end;
        Inc(Digits[SI]);
        if Digits[SI] <= '9' then
          Break;
        Digits[SI] := #0;
      until False;
    end;
  end;
  SI := 0;
  if D >= 0 then
  begin
    if Neg then
      Result := Result + '-';
    CX := E;
    if CX < 0 then
      Result := Result + '0'
    else
      repeat
        Result := Result + NextDigit;
        Dec(CX);
      until CX < 0;
    if D = 0 then
      Exit;
    Result := Result + '.';
    repeat
      Inc(CX);
      if CX = 0 then
        Break;
      Result := Result + '0';
      Dec(D);
    until D = 0;
    repeat
      Dec(D);
      if D < 0 then
        Break;
      Result := Result + NextDigit;
    until False;
  end
  else
  begin
    if Neg then
      Result := Result + '-'
    else
      Result := Result + ' ';
    Result := Result + NextDigit;
    Inc(D);
    if D <> 0 then
    begin
      Result := Result + '.';
      repeat
        Result := Result + NextDigit;
        Inc(D);
      until D = 0;
    end;
    Result := Result + 'E';
    if E < 0 then
    begin
      Result := Result + '-';
      E := -E;
    end
    else
      Result := Result + '+';
    Result := Result + Chr(Byte(E div 10 + $30)) + Chr(Byte(E mod 10 + $30));   { IDIV DL }
  end;
end;

function R48Str(const A: TReal48; Width, Decimals: SmallInt): RawByteString;
const
  MaxLen = 255;
var
  CX, W: SmallInt;
  S: RawByteString;
begin
  CX := Decimals;
  if CX < 0 then
  begin
    CX := 6 - Width;
    if CX > -2 then
      CX := -2;
  end;
  S := RealToStr(A, CX);
  CX := Length(S);
  W := Width;
  if W > MaxLen then W := MaxLen;
  if CX > MaxLen then CX := MaxLen;
  if W < CX then W := CX;
  Result := StringOfChar(' ', W - CX) + Copy(S, 1, CX);
end;

function R48ToDouble(const A: TReal48): Double;
var
  M: QWord;
  I: Integer;
begin
  if A[0] = 0 then
    Exit(0.0);
  M := 0;
  for I := 5 downto 1 do
    M := (M shl 8) or A[I];
  Result := LdExp(1.0 + (M and $7FFFFFFFFF) / 549755813888.0, A[0] - 129);
  if (A[5] and $80) <> 0 then
    Result := -Result;
end;

function DoubleToR48(D: Double): TReal48;
var
  E: Integer;
  M: QWord;
  Neg: Boolean;
  F: Double;
  I: Integer;
begin
  FillChar(Result, SizeOf(Result), 0);
  if D = 0 then
    Exit;
  Neg := D < 0;
  F := Abs(D);
  E := 0;
  while F >= 2.0 do begin F := F / 2; Inc(E); end;
  while F < 1.0 do begin F := F * 2; Dec(E); end;
  M := Round((F - 1.0) * 549755813888.0);
  if M >= QWord($8000000000) then
  begin
    M := 0;
    Inc(E);
  end;
  if Neg then
    M := M or QWord($8000000000);
  Result[0] := E + 129;
  for I := 1 to 5 do
  begin
    Result[I] := M and $FF;
    M := M shr 8;
  end;
end;

procedure NextRandSeed;
begin
  RandSeed := RandSeed * $08088405 + 1;
end;

function Random(Range: Word): Word;
begin
  NextRandSeed;
  Result := (QWord(RandSeed) * Range) shr 32;
end;

function RandomReal: TReal48;
var
  M: LongWord;
  E: Integer;
begin
  { System.RandomReal 10c8:135f: RandSeed / 2^32, normalised; exponent starts
    at $80 and drops by one per shift; 0 if the seed is 0 }
  NextRandSeed;
  M := RandSeed;
  E := $80;
  FillChar(Result, SizeOf(Result), 0);
  if M = 0 then
    Exit;
  while (M and $80000000) = 0 do
  begin
    M := M shl 1;
    Dec(E);
  end;
  Result[0] := E;
  Result[1] := 0;
  Result[2] := M and $FF;
  Result[3] := (M shr 8) and $FF;
  Result[4] := (M shr 16) and $FF;
  Result[5] := ((M shr 24) and $FF) and $7F;
end;

end.
